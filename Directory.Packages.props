<Project>
<PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="ConsoleTableExt" Version="3.3.0" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="TUnit.Playwright" Version="1.75.0" />
    <PackageVersion Include="VarDump" Version="2.0.9" />
    <PackageVersion Include="Novolis.CodeGen.Reflection.Dump" Version="2026.1.*" />
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <PackageVersion Include="AlmostServiceBus.TestHost" Version="0.7.2" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Abstractions" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Broker.Almost" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Client" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Primitives" Version="2026.1.*" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>

