    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="TUnit" Version="1.72.4" />
    <PackageVersion Include="VarDump" Version="1.0.6" />
    <PackageVersion Include="Novolis.CodeGen.Reflection.Dump" Version="2026.1.*" />
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <PackageVersion Include="AlmostServiceBus.TestHost" Version="0.3.1" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Abstractions" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Broker.Almost" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Client" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Messaging.ServiceBus.Primitives" Version="2026.1.*" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
